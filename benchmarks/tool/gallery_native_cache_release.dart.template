// Standalone Linux release entry point; no production application is started.
// The two imports are immutable cache snapshots, not the current working tree.
// ignore_for_file: avoid_dynamic_calls, depend_on_referenced_packages
import 'dart:convert';
import 'dart:io';
import 'dart:math' as math;

import 'package:crypto/crypto.dart';
import 'package:flutter/foundation.dart';
import 'package:flutter/widgets.dart';
import 'package:path_provider/path_provider.dart';

import __BASELINE_CACHE_IMPORT__ as baseline;
import __PRODUCTION_CACHE_IMPORT__ as production;

enum _Variant { baseline, production }

_Variant _parseVariant(String value) => switch (value) {
  'baseline' => _Variant.baseline,
  'production' => _Variant.production,
  _ => throw ArgumentError('Unknown frozen cache variant'),
};

final _variant = _parseVariant(
  const String.fromEnvironment('GALLERY_CACHE_VARIANT'),
);
const _count = 63;
const _concurrency = 4;
const _trials = 5;
const _chunkBytes = 8192;

dynamic _cache(Directory directory) => switch (_variant) {
  _Variant.baseline => baseline.GalleryNativeImageCache(directory: directory),
  _Variant.production => production.GalleryNativeImageCache(directory: directory),
};

void _require(bool condition, String message) {
  if (!condition) throw StateError(message);
}

Future<void> _verifyFile(String path, Uint8List payload) async {
  final actual = await File(path).readAsBytes();
  _require(listEquals(actual, payload), 'Published payload differs');
}

Future<Map<String, Object?>> _trial(
  Directory parent,
  Uint8List payload,
  int trial,
) async {
  final directory = await parent.createTemp('gallery-cold-probe-release-');
  final dynamic cache = _cache(directory);
  final images = <dynamic>[];
  final paths = <String>[];
  final writeMs = <double>[];
  try {
    var next = 0;
    final total = Stopwatch()..start();
    await Future.wait(
      List.generate(_concurrency, (_) async {
        while (next < _count) {
          final index = next++;
          final watch = Stopwatch()..start();
          final dynamic image = await cache.write(
            'scope:$index:revision1:256',
            Stream<List<int>>.fromIterable([
              for (
                var offset = 0;
                offset < payload.length;
                offset += _chunkBytes
              )
                Uint8List.sublistView(
                  payload,
                  offset,
                  math.min(offset + _chunkBytes, payload.length),
                ),
            ]),
          );
          image.retain();
          images.add(image);
          writeMs.add(watch.elapsedMicroseconds / 1000);
          _require(
            image.filePath != null,
            'Expected native disk cache payload',
          );
          _require(image.byteLength == payload.length, 'Wrong payload length');
          paths.add(image.filePath as String);
        }
      }),
    );
    total.stop();
    // Correctness checks are outside the timed write window and before close.
    for (final path in paths) {
      await _verifyFile(path, payload);
    }
    final temporary = await directory
        .list()
        .where((entry) => entry.path.endsWith('.part'))
        .length;
    _require(temporary == 0, 'Completed batch left temporary files');
    for (final dynamic image in images) {
      image.release();
    }
    images.clear();
    final close = Stopwatch()..start();
    await cache.close();
    close.stop();
    final dynamic reopened = _cache(directory);
    var hits = 0;
    try {
      for (var index = 0; index < _count; index++) {
        final dynamic image = await reopened.get('scope:$index:revision1:256');
        _require(image != null && image.filePath != null, 'Reopen cache miss');
        image.retain();
        try {
          await _verifyFile(image.filePath as String, payload);
          hits++;
        } finally {
          image.release();
        }
      }
    } finally {
      await reopened.close();
    }
    return {
      'trial': trial,
      'writes': _count,
      'concurrency': _concurrency,
      'payload_bytes': payload.length,
      'chunk_bytes': _chunkBytes,
      'fixture_directory': directory.path,
      'total_write_ms': total.elapsedMicroseconds / 1000,
      'write_ms': writeMs,
      'close_ms': close.elapsedMicroseconds / 1000,
      'complete_immediate_payloads_verified': paths.length,
      'reopened_hits_verified': hits,
      'cache_max_bytes': cache.maxBytes as int,
      'cache_max_objects': cache.maxObjects as int,
    };
  } finally {
    for (final dynamic image in images) {
      image.release();
    }
    await cache.close();
    await directory.delete(recursive: true);
  }
}

Future<void> main(List<String> arguments) async {
  WidgetsFlutterBinding.ensureInitialized();
  try {
    _require(
      kReleaseMode,
      'This probe must be compiled in Flutter release mode',
    );
    _require(
      arguments.length == 2,
      'Expected payload path and output JSON path',
    );
    final payload = await File(arguments[0]).readAsBytes();
    final parent = await getApplicationCacheDirectory();
    _require(await parent.exists(), 'Application cache parent does not exist');
    final results = <Map<String, Object?>>[];
    for (var trial = 0; trial < _trials; trial++) {
      results.add(await _trial(parent, payload, trial));
      stdout.writeln('GALLERY_RELEASE_TRIAL ${_variant.name} $trial complete');
    }
    final output = {
      'variant': _variant.name,
      'build_mode': 'release',
      'sdk': Platform.version,
      'os': Platform.operatingSystemVersion,
      'processors': Platform.numberOfProcessors,
      'fixture_parent': parent.path,
      'payload_sha256': sha256.convert(payload).toString(),
      'scope':
          'Linux release; disk cache only; fresh cache directories; '
          'no HTTP, image decode, UI timing or Pi',
      'trials': results,
    };
    await File(arguments[1]).writeAsString(
      const JsonEncoder.withIndent('  ').convert(output),
      flush: true,
    );
    stdout.writeln('GALLERY_RELEASE_RESULT ${arguments[1]}');
    exit(0);
  } catch (error, stack) {
    stderr.writeln('$error\n$stack');
    exit(1);
  }
}
